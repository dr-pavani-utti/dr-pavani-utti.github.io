---
import '../styles/global.css';
import { absolute, asset, SITE_URL } from '../site';

interface Props {
	title: string;
	description: string;
	/** JSON-LD structured data for the page. */
	jsonLd?: object;
}

const { title, description, jsonLd } = Astro.props;
const ogImage = absolute('/og-image.png');
---

<!doctype html>
<html lang="en-IN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Dr. Pavani Utti" />
		<meta name="robots" content="index, follow, max-image-preview:large" />
		<link rel="canonical" href={SITE_URL} />

		<link rel="icon" href={asset('/favicon.ico')} sizes="48x48" />
		<link rel="icon" type="image/png" href={asset('/favicon-96x96.png')} sizes="96x96" />
		<link rel="icon" type="image/png" href={asset('/icon-192.png')} sizes="192x192" />
		<link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
		<link rel="manifest" href={asset('/site.webmanifest')} />
		<meta name="theme-color" content="#0d9488" />

		<meta property="og:type" content="profile" />
		<meta property="og:site_name" content="Dr. Pavani Utti" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={SITE_URL} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Dr. Pavani Utti, General Surgeon" />
		<meta property="og:locale" content="en_IN" />
		<meta property="profile:first_name" content="Pavani" />
		<meta property="profile:last_name" content="Utti" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=Inter:wght@400..700&display=swap" rel="stylesheet">
		<!-- Reveal-on-scroll styles apply only when JS runs, so content is never hidden without it. -->
		<script is:inline>document.documentElement.classList.add('js')</script>
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
	</head>
	<body class="bg-cream text-ink font-sans antialiased selection:bg-sky-cap selection:text-ink relative min-h-screen overflow-x-clip">
		<div class="aurora" aria-hidden="true">
			<span class="aurora-blob aurora-a"></span>
			<span class="aurora-blob aurora-b"></span>
			<span class="aurora-blob aurora-c"></span>
			<span class="aurora-grain"></span>
		</div>
		<slot />
		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
