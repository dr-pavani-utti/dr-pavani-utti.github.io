---
import Layout from '../layouts/Layout.astro';
import { absolute, asset, LINKEDIN, PROJECTS, SITE_URL } from '../site';

const title = 'Dr. Pavani Utti | General Surgeon, Bengaluru';
const description =
  'Dr. Pavani Utti is a General Surgeon in Bengaluru, Karnataka, trained in General Surgery at Bangalore Medical College and Research Institute (BMCRI). MBBS gold medalist.';

const faqs = [
  {
    q: 'Who is Dr. Pavani Utti?',
    a: 'Dr. Pavani Utti is a General Surgeon based in Bengaluru, Karnataka, India. She completed her postgraduate General Surgery residency at Bangalore Medical College and Research Institute (BMCRI) in October 2026, after earning her MBBS from NTR University of Health Sciences with gold medals in General Surgery and in Obstetrics & Gynaecology.',
  },
  {
    q: 'Where did Dr. Pavani Utti train in General Surgery?',
    a: 'Dr. Pavani Utti trained as a General Surgery resident at Bangalore Medical College and Research Institute (BMCRI), Bengaluru, from September 2023 to October 2026.',
  },
  {
    q: 'Where did Dr. Pavani Utti study medicine?',
    a: 'Dr. Pavani Utti earned her Bachelor of Medicine, Bachelor of Surgery (MBBS) from NTR University of Health Sciences, Andhra Pradesh (August 2016 – June 2021).',
  },
  {
    q: 'What awards has Dr. Pavani Utti received?',
    a: 'Dr. Pavani Utti was awarded the Gold Medal in General Surgery and the Gold Medal in Obstetrics & Gynaecology by NTR University of Health Sciences in March 2021.',
  },
  {
    q: 'What are the NEET PG and NEET SS Cutoff Explorers?',
    a: 'They are free websites created by Dr. Pavani Utti that show college-wise NEET PG and NEET SS closing ranks for every course, quota, category and MCC counselling round, built from the official MCC allotment PDFs, with a rank predictor for medical aspirants.',
  },
];

const personId = `${SITE_URL}#person`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}#website`,
      url: SITE_URL,
      name: 'Dr. Pavani Utti',
      alternateName: ['Pavani Utti', 'Dr Pavani Utti'],
      inLanguage: 'en-IN',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${SITE_URL}#profile`,
      url: SITE_URL,
      name: title,
      description,
      isPartOf: { '@id': `${SITE_URL}#website` },
      mainEntity: { '@id': personId },
      dateModified: new Date().toISOString().slice(0, 10),
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: 'Dr. Pavani Utti',
      givenName: 'Pavani',
      familyName: 'Utti',
      honorificPrefix: 'Dr.',
      alternateName: ['Pavani Utti', 'Dr Pavani Utti', 'Dr. Pavani'],
      jobTitle: 'General Surgeon',
      description,
      url: SITE_URL,
      image: absolute('/icons/profile-pic.png'),
      sameAs: [LINKEDIN],
      gender: 'Female',
      nationality: { '@type': 'Country', name: 'India' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Bengaluru',
        addressRegion: 'Karnataka',
        addressCountry: 'IN',
      },
      hasOccupation: {
        '@type': 'Occupation',
        name: 'General Surgeon',
        occupationLocation: { '@type': 'City', name: 'Bengaluru' },
      },
      knowsAbout: ['General Surgery', 'Surgical patient care', 'Emergency surgery', 'NEET PG counselling', 'NEET SS counselling'],
      alumniOf: [
        {
          '@type': 'CollegeOrUniversity',
          name: 'Bangalore Medical College and Research Institute',
          alternateName: 'BMCRI',
          address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressRegion: 'Karnataka', addressCountry: 'IN' },
        },
        {
          '@type': 'CollegeOrUniversity',
          name: 'NTR University of Health Sciences',
          alternateName: 'NTRUHS',
          address: { '@type': 'PostalAddress', addressLocality: 'Vijayawada', addressRegion: 'Andhra Pradesh', addressCountry: 'IN' },
        },
      ],
      award: [
        'Gold Medal in General Surgery, NTR University of Health Sciences (2021)',
        'Gold Medal in Obstetrics & Gynaecology, NTR University of Health Sciences (2021)',
      ],
    },
    ...PROJECTS.map((p) => ({
      '@type': 'WebApplication',
      name: p.name,
      url: p.url,
      description: p.description,
      applicationCategory: 'EducationalApplication',
      operatingSystem: 'Any',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'INR' },
      creator: { '@id': personId },
    })),
  ],
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <header class="bg-white/70 backdrop-blur-md border-b border-slate-200/60 sticky top-0 z-10">
    <div class="max-w-4xl mx-auto px-6 py-4 flex justify-between items-center">
      <a href={asset('/')} aria-label="Dr. Pavani Utti – Home">
        <img src={asset('/icons/caduceus-icon.png')} alt="" width="32" height="32" class="h-8 w-auto mix-blend-multiply" />
      </a>
      <nav class="hidden md:flex gap-6 text-sm font-medium text-slate-600" aria-label="Sections">
        <a href="#about" class="hover:text-teal-600 transition-colors">About</a>
        <a href="#experience" class="hover:text-teal-600 transition-colors">Experience</a>
        <a href="#education" class="hover:text-teal-600 transition-colors">Education</a>
        <a href="#awards" class="hover:text-teal-600 transition-colors">Awards</a>
        <a href="#projects" class="hover:text-teal-600 transition-colors">Projects</a>
        <a href="#faq" class="hover:text-teal-600 transition-colors">FAQ</a>
      </nav>
      <a href={LINKEDIN} target="_blank" rel="noopener noreferrer me" class="opacity-80 hover:opacity-100 transition-opacity" aria-label="Dr. Pavani Utti on LinkedIn">
        <img src={asset('/icons/linkedin-icon.png')} alt="LinkedIn" width="24" height="24" class="w-6 h-6 object-contain mix-blend-multiply" />
      </a>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-6 py-12 md:py-20 space-y-24">
    <!-- Hero Section -->
    <section id="about" class="scroll-mt-24 flex flex-col-reverse md:flex-row items-center justify-between gap-12 pt-8">
      <div class="flex-1 space-y-6 text-center md:text-left">
        <div class="space-y-2">
          <h1 class="text-4xl md:text-5xl font-bold text-slate-900 tracking-tight">Dr. Pavani Utti</h1>
          <p class="text-xl md:text-2xl text-teal-600 font-medium">General Surgeon · Bengaluru, India</p>
        </div>
        
        <p class="text-slate-600 leading-relaxed text-lg max-w-2xl">
          Dr. Pavani Utti is a General Surgeon trained at Bangalore Medical College and Research Institute (BMCRI), committed to compassionate patient care, surgical excellence, and continuous medical learning.
        </p>

        <!-- Stats -->
        <div class="flex flex-wrap justify-center md:justify-start gap-4 pt-4">
          <!-- Patients Served -->
          <div class="bg-white/60 backdrop-blur-sm border border-slate-200/60 rounded-2xl p-4 shadow-sm flex items-center gap-4 w-full sm:w-auto">
            <div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-2xl font-bold text-slate-800">1000+</span>
              <span class="text-sm text-slate-500 font-medium">Patients Served</span>
            </div>
          </div>

          <!-- Surgeries -->
          <div class="bg-white/60 backdrop-blur-sm border border-slate-200/60 rounded-2xl p-4 shadow-sm flex items-center gap-4 w-full sm:w-auto">
            <div class="w-12 h-12 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-2xl font-bold text-slate-800">200+</span>
              <span class="text-sm text-slate-500 font-medium">Surgeries</span>
            </div>
          </div>

          <!-- Experience -->
          <div class="bg-white/60 backdrop-blur-sm border border-slate-200/60 rounded-2xl p-4 shadow-sm flex items-center gap-4 w-full sm:w-auto">
            <div class="w-12 h-12 rounded-full bg-amber-100 flex items-center justify-center text-amber-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-award"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-2xl font-bold text-slate-800">3+ Years</span>
              <span class="text-sm text-slate-500 font-medium">of experience</span>
            </div>
          </div>

          <!-- Patient Care -->
          <div class="bg-white/60 backdrop-blur-sm border border-slate-200/60 rounded-2xl p-4 shadow-sm flex items-center gap-4 w-full sm:w-auto">
            <div class="w-12 h-12 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-2xl font-bold text-slate-800">24/7</span>
              <span class="text-sm text-slate-500 font-medium">Patient Care</span>
            </div>
          </div>
        </div>
      </div>
      
      <div class="flex-shrink-0 relative group">
        <div class="absolute inset-0 bg-teal-100 rounded-full blur-2xl opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>
        <img 
          src={asset('/icons/profile-pic.png')} 
          alt="Dr. Pavani Utti, General Surgeon, Bengaluru" 
          width="256"
          height="256"
          class="relative w-48 h-48 md:w-64 md:h-64 rounded-full object-cover border-4 border-white shadow-xl"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- Biography Section -->
    <section id="bio" class="scroll-mt-24 space-y-6">
      <h2 class="text-2xl font-bold text-slate-900">About Dr. Pavani Utti</h2>
      <div class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-slate-200/60 shadow-sm space-y-4 text-slate-600 leading-relaxed">
        <p>
          <strong class="text-slate-800">Dr. Pavani Utti</strong> is a General Surgeon based in Bengaluru, Karnataka. She completed her postgraduate residency in General Surgery at <strong class="text-slate-800">Bangalore Medical College and Research Institute (BMCRI)</strong>, one of India's oldest and busiest government medical colleges, between September 2023 and October 2026.
        </p>
        <p>
          Over three years of full-time, on-site surgical training at BMCRI's teaching hospitals, Dr. Pavani Utti has cared for more than 1,000 patients and taken part in over 200 surgeries, working across outpatient clinics, wards, operating theatres and round-the-clock emergency duty.
        </p>
        <p>
          Before her surgical training she earned her MBBS from <strong class="text-slate-800">NTR University of Health Sciences</strong> (2016–2021), where she was awarded the <strong class="text-slate-800">Gold Medal in General Surgery</strong> and the <strong class="text-slate-800">Gold Medal in Obstetrics &amp; Gynaecology</strong>.
        </p>
        <p>
          Beyond clinical work, Dr. Pavani Utti builds free tools for fellow doctors. Her <a href={PROJECTS[0].url} class="text-teal-700 font-medium underline decoration-teal-300 underline-offset-2 hover:text-teal-900">NEET PG Cutoff Explorer</a> and <a href={PROJECTS[1].url} class="text-teal-700 font-medium underline decoration-teal-300 underline-offset-2 hover:text-teal-900">NEET SS Cutoff Explorer</a> turn the official MCC counselling allotment lists into searchable, college-wise closing ranks and rank predictors for postgraduate and super-speciality aspirants across India.
        </p>
      </div>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="scroll-mt-24 space-y-8">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-teal-100 text-teal-700 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
        </div>
        <h2 class="text-2xl font-bold text-slate-900">Experience</h2>
      </div>
      
      <div class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-slate-200/60 shadow-sm relative overflow-hidden">
        <div class="absolute top-0 left-0 w-2 h-full bg-teal-500"></div>
        <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-4">
          <div>
            <h4 class="text-xl font-semibold text-slate-900">General Surgery Resident</h4>
            <p class="text-slate-700 font-medium mt-1">Bangalore Medical College and Research Institute</p>
            
            <div class="flex flex-wrap gap-y-2 gap-x-4 mt-4 text-sm text-slate-500">
              <div class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                Sep 2023 – Oct 2026 · 3 yrs 2 mos (Completed)
              </div>
              <div class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                Bengaluru, Karnataka, India
              </div>
              <div class="flex items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase-business"><path d="M12 12h.01"/><path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M22 13a18.15 18.15 0 0 1-20 0"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
                Full-time · On-site
              </div>
            </div>
          </div>
          <div class="shrink-0 mt-4 md:mt-0">
            <img src={asset('/icons/bmcri-logo.png')} alt="Bangalore Medical College and Research Institute (BMCRI) logo" width="112" height="112" loading="lazy" class="w-20 h-20 md:w-28 md:h-28 object-contain mix-blend-multiply opacity-90" />
          </div>
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section id="education" class="scroll-mt-24 space-y-8">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-blue-100 text-blue-700 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-graduation-cap"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        </div>
        <h2 class="text-2xl font-bold text-slate-900">Education</h2>
      </div>
      
      <div class="space-y-6">
        <!-- Education 1 -->
        <div class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-slate-200/60 shadow-sm relative overflow-hidden transition-all hover:shadow-md">
          <div class="flex flex-col md:flex-row md:items-start gap-4">
            <div class="shrink-0 bg-slate-50/50 p-3 md:p-4 rounded-2xl border border-slate-100/50 mt-2 md:mt-0">
              <img src={asset('/icons/bmcri-logo.png')} alt="Bangalore Medical College and Research Institute (BMCRI) logo" width="96" height="96" loading="lazy" class="w-20 h-20 md:w-24 md:h-24 object-contain mix-blend-multiply" />
            </div>
            <div class="flex-1">
              <h4 class="text-xl font-semibold text-slate-900">Bangalore Medical College and Research Institute</h4>
              <p class="text-slate-700 mt-1">Postgraduate Degree, General Surgery Residency Program (Completed)</p>
              <div class="flex items-center gap-1 mt-3 text-sm text-slate-500 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                Sep 2023 – Oct 2026
              </div>
            </div>
          </div>
        </div>

        <!-- Education 2 -->
        <div class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 md:p-8 border border-slate-200/60 shadow-sm relative overflow-hidden transition-all hover:shadow-md">
          <div class="flex flex-col md:flex-row md:items-start gap-4">
            <div class="shrink-0 bg-slate-50/50 p-3 md:p-4 rounded-2xl border border-slate-100/50 mt-2 md:mt-0">
              <img src={asset('/icons/ntr-logo.png')} alt="NTR University of Health Sciences logo" width="96" height="96" loading="lazy" class="w-20 h-20 md:w-24 md:h-24 object-contain mix-blend-multiply" />
            </div>
            <div class="flex-1">
              <h4 class="text-xl font-semibold text-slate-900">NTR University of Health Sciences</h4>
              <p class="text-slate-700 mt-1">Bachelor of Medicine, Bachelor of Surgery - MBBS, Medicine</p>
              <div class="flex items-center gap-1 mt-3 text-sm text-slate-500 font-medium">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
                Aug 2016 – Jun 2021
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Honors & Awards Section -->
    <section id="awards" class="scroll-mt-24 space-y-8">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-yellow-100 text-yellow-700 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-award"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
        </div>
        <h2 class="text-2xl font-bold text-slate-900">Honors &amp; Awards</h2>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Award 1 -->
        <div class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 border border-yellow-200/60 shadow-sm relative overflow-hidden group hover:shadow-md transition-all">
          <div class="absolute -right-4 -top-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="currentColor" class="text-yellow-500"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
          </div>
          <div class="relative z-10 space-y-3">
            <h4 class="text-lg font-bold text-slate-900">Gold Medal in General Surgery</h4>
            <div class="flex items-center gap-2 text-sm text-slate-600 font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              Mar 2021
            </div>
            <p class="text-sm text-slate-500 leading-relaxed pt-2 border-t border-slate-100">
              Associated with NTR University of Health Sciences
            </p>
          </div>
        </div>

        <!-- Award 2 -->
        <div class="bg-white/60 backdrop-blur-sm rounded-2xl p-6 border border-yellow-200/60 shadow-sm relative overflow-hidden group hover:shadow-md transition-all">
          <div class="absolute -right-4 -top-4 opacity-10 group-hover:opacity-20 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 24 24" fill="currentColor" class="text-yellow-500"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
          </div>
          <div class="relative z-10 space-y-3">
            <h4 class="text-lg font-bold text-slate-900">Gold Medal in Obstetrics & Gynaecology</h4>
            <div class="flex items-center gap-2 text-sm text-slate-600 font-medium">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>
              Mar 2021
            </div>
            <p class="text-sm text-slate-500 leading-relaxed pt-2 border-t border-slate-100">
              Associated with NTR University of Health Sciences
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="scroll-mt-24 space-y-8">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-indigo-100 text-indigo-700 rounded-lg">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-column"><path d="M3 3v16a2 2 0 0 0 2 2h16"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
        </div>
        <h2 class="text-2xl font-bold text-slate-900">Projects</h2>
      </div>
      <p class="text-slate-600 leading-relaxed">
        Free tools by Dr. Pavani Utti that help medical graduates and residents plan NEET PG and NEET SS counselling with real allotment data.
      </p>

      <div class="grid md:grid-cols-2 gap-6">
        {PROJECTS.map((p) => (
          <a href={p.url} class="block bg-white/60 backdrop-blur-sm rounded-2xl p-6 border border-indigo-200/60 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all group">
            <div class="space-y-3">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-indigo-700 transition-colors">{p.name} →</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{p.description}</p>
              <ul class="flex flex-wrap gap-2 pt-2 border-t border-slate-100">
                {p.keywords.map((k) => (
                  <li class="text-xs font-medium text-indigo-700 bg-indigo-50 rounded-full px-2.5 py-1">{k}</li>
                ))}
              </ul>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="scroll-mt-24 space-y-8 pb-12">
      <h2 class="text-2xl font-bold text-slate-900">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map((f) => (
          <details class="bg-white/60 backdrop-blur-sm rounded-2xl p-5 border border-slate-200/60 shadow-sm group" open>
            <summary class="font-semibold text-slate-900 cursor-pointer list-none flex justify-between items-center gap-4">
              <h3>{f.q}</h3>
              <span class="text-teal-600 transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-slate-600 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="bg-white/50 backdrop-blur-md border-t border-slate-200/60 py-8 text-center text-slate-500 text-sm">
    <div class="max-w-4xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
      <p>&copy; {new Date().getFullYear()} Dr. Pavani Utti · General Surgeon, Bengaluru</p>
      <nav class="flex flex-wrap justify-center gap-x-5 gap-y-2" aria-label="Links">
        {PROJECTS.map((p) => (
          <a href={p.url} class="hover:text-teal-600 font-medium transition-colors">{p.name}</a>
        ))}
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer me" class="hover:text-blue-600 font-medium transition-colors">LinkedIn</a>
      </nav>
    </div>
  </footer>
</Layout>
